rules_version = '2';

// Pannipe — Storage rules
//   stores/{ownerUid}/profile.jpg
//   stores/{ownerUid}/products/{file}
service firebase.storage {
  match /b/{bucket}/o {
    match /stores/{ownerUid}/{allPaths=**} {
      allow read: if true; // store/product photos are public
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
