rules_version = '2';

// Pannipe — Firestore security rules
//
// Auth: Firebase Email/Password + Google (package com.pannipe.app).
// Data model
//   users/{uid}                          private profile (email, name, phone, fcmTokens)
//   stores/{ownerUid}                    one store per seller; doc id == owner uid
//   stores/{ownerUid}/products/{pid}     store catalogue
//   orders/{orderId}                     customerId + storeId (== seller uid)
//
// Cloud Functions (Admin SDK) bypass these rules for fee verification + FCM.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── users ────────────────────────────────────────────────────────────
    // email must match the signed-in token (it can't be spoofed); name/phone are bounded.
    function validUser(d) {
      return (!('email' in d) || d.email == request.auth.token.get('email', ''))
          && (!('name' in d) || (d.name is string && d.name.size() <= 60))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20));
    }

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && validUser(request.resource.data);
      allow delete: if false;
    }

    // ── stores ───────────────────────────────────────────────────────────
    function validStore(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
          && d.description is string && d.description.size() <= 500
          && d.location is latlng
          && d.freeWithinKm is number && d.freeWithinKm >= 0 && d.freeWithinKm <= 100
          && d.chargePerKm is number && d.chargePerKm >= 0 && d.chargePerKm <= 1000
          && d.ownerId == request.auth.uid;
    }

    match /stores/{storeId} {
      allow read: if true; // public catalogue (guests can browse)
      allow create: if isUser(storeId) && validStore(request.resource.data);
      allow update: if isUser(storeId) && validStore(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /products/{productId} {
        allow read: if true;
        allow create, update: if isUser(storeId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.inStock is bool;
        allow delete: if isUser(storeId);
      }
    }

    // ── orders ───────────────────────────────────────────────────────────
    // Status flow:
    //   placed → accepted → preparing → out_for_delivery → delivered → completed
    //   placed → cancelled (customer)      placed|accepted → rejected (seller)
    function sellerTransition(from, to) {
      return (from == 'placed' && to in ['accepted', 'rejected'])
          || (from == 'accepted' && to in ['preparing', 'out_for_delivery', 'rejected'])
          || (from == 'preparing' && to == 'out_for_delivery')
          || (from == 'out_for_delivery' && to == 'delivered');
    }
    function customerTransition(from, to) {
      return (from == 'placed' && to == 'cancelled')
          || (from == 'delivered' && to == 'completed');
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.storeId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.storeId != request.auth.uid
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.total is number
        && request.resource.data.deliveryLocation is latlng;

      allow update: if signedIn()
        && changed().hasOnly(['status', 'updatedAt', 'cancelReason', 'statusTimes'])
        && (
          (resource.data.storeId == request.auth.uid
             && sellerTransition(resource.data.status, request.resource.data.status))
          ||
          (resource.data.customerId == request.auth.uid
             && customerTransition(resource.data.status, request.resource.data.status))
        );

      allow delete: if false;
    }
  }
}
