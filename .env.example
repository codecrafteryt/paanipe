# Copy to `.env` and fill real values. Never commit `.env`.
# Package / bundle ID (Android + iOS): com.pannipe.app
# After editing, also sync native keys:
#   - android/secrets.properties  → MAPS_API_KEY=<GOOGLE_MAPS_API_KEY>
#   - ios/Runner/Secrets.plist    → GOOGLE_MAPS_API_KEY
#   - android/app/google-services.json  (from Firebase / flutterfire configure)
#   - ios/Runner/GoogleService-Info.plist

BASE_URL=
SOCKET_URL=

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

YANDEX_MAPS_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PAYMENT_INTENT_URL=

# Firebase project: pannipe-app  |  apps use package com.pannipe.app
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key
FIREBASE_ANDROID_APP_ID=1:300152990197:android:beb16c27282f2c956398bc
FIREBASE_MESSAGING_SENDER_ID=300152990197
FIREBASE_PROJECT_ID=pannipe-app
FIREBASE_STORAGE_BUCKET=pannipe-app.firebasestorage.app

FIREBASE_IOS_API_KEY=your_firebase_ios_api_key
FIREBASE_IOS_APP_ID=1:300152990197:ios:0ececcb8f9ebf5f76398bc
FIREBASE_IOS_BUNDLE_ID=com.pannipe.app

# Required for Google Sign-In on Android (OAuth 2.0 Web client ID = client_type 3
# in google-services.json). Also copy:
#   android/app/google-services.json  (git-ignored)
#   ios/Runner/GoogleService-Info.plist (git-ignored)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
