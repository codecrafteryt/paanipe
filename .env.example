# Copy to `.env` and fill real values. Never commit `.env`.
# After editing, also sync native keys:
#   - android/secrets.properties  → MAPS_API_KEY=<GOOGLE_MAPS_API_KEY>
#   - ios/Runner/Secrets.plist    → GOOGLE_MAPS_API_KEY
#   - android/app/google-services.json  (from Firebase console / FlutterFire)
#   - ios/Runner/GoogleService-Info.plist (when iOS Firebase is configured)

BASE_URL=
SOCKET_URL=

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

YANDEX_MAPS_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PAYMENT_INTENT_URL=

FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key
FIREBASE_ANDROID_APP_ID=1:YOUR_PROJECT_NUMBER:android:YOUR_ANDROID_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_PROJECT_NUMBER
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

FIREBASE_IOS_API_KEY=your_firebase_ios_api_key
FIREBASE_IOS_APP_ID=1:YOUR_PROJECT_NUMBER:ios:YOUR_IOS_APP_ID
FIREBASE_IOS_BUNDLE_ID=com.pannipe.app
