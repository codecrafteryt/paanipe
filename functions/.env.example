# Cloud Functions do NOT load this file in production.
# SMTP and other secrets are set with:
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
#
# Optional params (firebase functions:config or params):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   MAIL_FROM=noreply@yourdomain.com
#
# Keep this file as documentation only. Never put real passwords here.
